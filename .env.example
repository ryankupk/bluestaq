# Copy to .env for local runs. Real environment variables override this file.

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# Database name. Point another instance at a different database to fully separate a team's notes.
MONGO_DB=notes

# Collection holding notes.
MONGO_NOTES_COLLECTION=notes

# debug | info | warn | error
LOG_LEVEL=info

# docker compose only: host port published for the mongo container.
# Change it if a local mongod already uses 27017.
MONGO_HOST_PORT=27017
