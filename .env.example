# Copy to .env for local runs. Real environment variables override this file.

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# Database name. Point another instance at a different database to fully separate a team's notes.
MONGO_DB=notes

# Collection holding notes.
MONGO_NOTES_COLLECTION=notes

# debug | info | warn | error
LOG_LEVEL=info

# How callers authenticate. Required; there is no default.
#   dev: POST /api/v1/auth/dev-token hands out a token for any user name. For local demos only,
#        because it proves nothing about who the caller is.
#   jwt: only tokens signed with JWT_SECRET are accepted, and there is no dev-token endpoint.
#        Another system (or your own tooling) must mint the tokens: HS256, claims sub (user
#        name), exp, and iss "notes".
AUTH_MODE=dev

# HS256 signing key, at least 32 bytes. Required in jwt mode. In dev mode a random one is
# generated at startup if unset, which means tokens stop working after a restart.
# Generate one with: openssl rand -hex 32
# JWT_SECRET=

# How long issued tokens stay valid (Go duration).
JWT_TTL=12h

# Comma-separated browser origins allowed to call the API and open the WebSocket from another
# origin, e.g. a separately hosted frontend. Empty means same-origin only (no CORS headers).
# The Vite dev server proxies to the API, so the demo does not need this.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# docker compose only: host port published for the mongo container.
# Change it if a local mongod already uses 27017.
MONGO_HOST_PORT=27017
